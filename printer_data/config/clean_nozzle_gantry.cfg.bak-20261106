[gcode_macro _CLEAN_NOZZLE_GANTRY]
gcode:
   SAVE_GCODE_STATE NAME=clean_nozzle_gantry
   G90
   G1 X30 F18000   #Adjust the X value position to be the X position left most of the brush, without touching it and without touching the nozzle parking spot/seal either.
   G1 X70 F18000   #Adjust the X value position to be the X position right most of the brush, without touching it.
   G1 Y349 F18000  #Adjust the Y355 position to be the middle of the brush 
   G1 X30 F18000
   G1 X70 F18000   
   RESTORE_GCODE_STATE NAME=clean_nozzle_gantry





# You can find your values by homing X & Y then using mainsail to place the toolhead at the left most side of the brush 
# and right most side of the brush. Adjust Y to be in the middle or as close to the middle as possible.

# Then update the below variables in the mmu_macro_vars.cfg as below. 

# ATTENTION: While the nozzle stop can withstand sustained heat of 287C (subject to the RTV used) 
# it is recommended to set the variable_enable_park_runout to false as you don't want to park the nozzle 
# on the seal and wait for extended periods of time to prevent it from melting.




# [gcode_macro _MMU_SEQUENCE_VARS]

# variable_enable_park_printing   : 'toolchange,load,unload,runout,pause,cancel'
# variable_enable_park_standalone : 'toolchange,load,unload,pause,cancel'
# variable_enable_park_disabled   : 'pause,cancel'


# variable_park_toolchange        : 24.5, 349, 1, 5, 2
# variable_park_runout            : 24.5, 349, 5, 10, 2
# variable_park_pause             : 24.5, 349, 5, 10, 2
# variable_park_cancel            : 24.5, 349, 10, 5, 5

# variable_post_form_tip_position : 24.5, 349, 0

# variable_user_post_load_extension     : ' _CLEAN_NOZZLE_GANTRY'

#####################################################################
#   Heat-resistant pad (left of the brush) — used by the Demon print-start hooks
#####################################################################
# The pad's left edge is bevelled; every other side can catch the nozzle. Always enter
# from the left: back off the brush row to approach_y, go to approach_x, move to pad_y,
# then slide right onto the pad. Leave the same way in reverse. The brush and pad ride on
# the gantry, so only X/Y matter. Positions jogged by Pato 2026-11-06.

[gcode_macro _PARK_ON_PAD]
description: Park the nozzle on the heat-resistant pad, entering over its bevelled left edge
variable_pad_x: 24.0
variable_pad_y: 348.0
variable_approach_x: 15.0
variable_approach_y: 340.0
gcode:
  _GO_TO_PAD_APPROACH
  G0 Y{pad_y} F6000
  G0 X{pad_x} F3000
  M400

[gcode_macro _LEAVE_PAD]
description: Back the nozzle off the pad to the left, then forward to the approach point
gcode:
  {% set pad = printer["gcode_macro _PARK_ON_PAD"] %}
  G90
  G0 X{pad.approach_x} F3000
  G0 Y{pad.approach_y} F6000
  M400

[gcode_macro _GO_TO_PAD_APPROACH]
description: From anywhere (e.g. over the brush), go to the pad approach point
gcode:
  {% set pad = printer["gcode_macro _PARK_ON_PAD"] %}
  G90
  {% if printer.toolhead.position.z < 10 %}
    G0 Z10 F1200
  {% endif %}
  G0 Y{pad.approach_y} F12000
  G0 X{pad.approach_x} F12000
  M400
